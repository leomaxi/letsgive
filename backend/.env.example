LETSGIVE_ENV=development
# Postgres:
LETSGIVE_DATABASE_URL=postgresql+asyncpg://letsgive:letsgive@localhost:5432/letsgive
# MySQL (equally supported -- pick one):
# LETSGIVE_DATABASE_URL=mysql+aiomysql://letsgive:letsgive@localhost:3306/letsgive
LETSGIVE_JWT_SECRET=change-me-to-a-long-random-value
LETSGIVE_ACCESS_TOKEN_EXPIRE_MINUTES=60
LETSGIVE_MFA_ISSUER=Let's Give

# Optional: real email delivery for finance approval codes.
# MXroute example. Use the sending mailbox address/password, not the MXroute API key.
# LETSGIVE_SMTP_PROVIDER=mxroute
# LETSGIVE_SMTP_PORT=587
# LETSGIVE_SMTP_USERNAME=noreply@yourdomain.org
# LETSGIVE_SMTP_PASSWORD=your-mailbox-or-app-password
# LETSGIVE_SMTP_FROM_EMAIL=noreply@yourdomain.org
# LETSGIVE_SMTP_USE_TLS=true

# Payments (subscriptions and session/export top-ups) go through Stripe. The
# Stripe secret key and webhook signing secret are entered by a platform
# admin under Admin -> Pricing & payments -- not here -- and stored encrypted.
# Stripe's return links point at the site the checkout started from; set this
# only if the public URL differs from what browsers send as their Origin.
# LETSGIVE_PUBLIC_APP_URL=https://letsgive.ca

# Legacy only: lets the old PayPal webhook keep handling any PayPal
# subscription that existed before the switch to Stripe.
# LETSGIVE_PAYPAL_ENVIRONMENT=live
# LETSGIVE_PAYPAL_CLIENT_ID=
# LETSGIVE_PAYPAL_CLIENT_SECRET=
# LETSGIVE_PAYPAL_WEBHOOK_ID=
